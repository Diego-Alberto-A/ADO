# Copia este archivo como keystore.properties y rellena los cuatro valores.
# keystore.properties está en .gitignore: NUNCA se sube al repositorio.
# Instrucciones completas en docs/RELEASE.md.

# Ruta al keystore (absoluta, o relativa a la raíz del proyecto).
storeFile=/ruta/a/crosswalker-release.jks

# Contraseña del keystore.
storePassword=

# Alias de la clave dentro del keystore.
keyAlias=crosswalker

# Contraseña de esa clave (suele ser la misma que storePassword).
keyPassword=
