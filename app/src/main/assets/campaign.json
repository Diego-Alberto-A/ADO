  "tools": [
    {
      "id": "look",
      "label": "Mirar",
      "icon": "◉",
      "cost": 1,
      "description": "Espera un hueco seguro antes de entrar a cada carril.",
      "category": "skill"
    },
    {
      "id": "eye",
      "label": "Confirmar alto",
      "icon": "●",
      "cost": 1,
      "description": "Espera a que TODOS los coches estén detenidos antes del cruce. Útil con un paso marcado o semáforo; no pide paso ni obliga a frenar. Sin ellos puede dejarte esperando.",
      "category": "skill"
    },
    {
      "id": "visible",
      "label": "Reflector",
      "icon": "●",
      "cost": 1,
      "description": "De noche, permite que los conductores te detecten antes. No ilumina tu vista ni obliga a frenar. De día no aporta ventaja.",
      "category": "skill"
    },
    {
      "id": "phone_away",
      "label": "Guardar celular",
      "icon": "●",
      "cost": 1,
      "description": "Quita la distracción de Tomás y recupera su paso normal. No comprueba el tráfico. No cambia nada en quien no lleva celular.",
      "category": "skill"
    },
    {
      "id": "speed_zone",
      "label": "Zona lenta",
      "icon": "●",
      "cost": 3,
      "description": "Reduce la velocidad de circulación al 55 %. Da más tiempo y reduce la distancia de frenado; no detiene los coches ni elimina los choques.",
      "category": "street"
    },
    {
      "id": "crosswalk",
      "label": "Paso accesible",
      "icon": "●",
      "cost": 2,
      "description": "Paso marcado con rampas en los cruces indicados. Permite cruzar a Mateo y avisa a conductores que puedan verte. No acelera peatones ni garantiza que frenen.",
      "category": "street"
    },
    {
      "id": "signal",
      "label": "Fase peatonal",
      "icon": "●",
      "cost": 3,
      "description": "En el Centro: rojo vehicular desde el inicio, paso peatonal del segundo 3 al 16 de cada ciclo de 22 s. Espera luz y tiempo suficiente; confirma el alto. No actúa en cruces laterales.",
      "category": "street"
    },
    {
      "id": "lighting",
      "label": "Iluminar cruce",
      "icon": "●",
      "cost": 2,
      "description": "Ilumina el Centro de noche para ver y ser visto antes. No elimina niebla ni obstáculos. De día o en cruces laterales no ayuda.",
      "category": "street"
    },
    {
      "id": "refuge",
      "label": "Isla de refugio",
      "icon": "●",
      "cost": 3,
      "description": "Solo en niveles con espacio para isla y solo en el Centro: divide el recorrido en dos tramos y permite esperar protegido a mitad. No reduce velocidad ni sustituye Mirar o Confirmar alto.",
      "category": "street"
    }
  ],
  "levels": [
    {
      "id": 1,
      "world": 0,
      "title": "Mi primer cruce",
      "lesson": "Toca MIRAR: cuesta 1 ficha y me hace esperar un hueco seguro antes de entrar a cada carril.",
      "budget": 3,
      "night": false,
      "walkers": [
        {
          "id": "ana",
          "name": "Ana",
          "kind": "impulsive",
          "speed": 0.12,
          "sprite": "walker_coral"
        }
      ],
      "lanes": [
        {
          "y": 0.5,
          "speed": 0.11,
          "offset": 0.6,
          "car": "car_coral"
        }
      ],
      "tools": [
        "look"
      ],
      "newTools": [
        "look"
      ],
      "tutorial": true,
      "introLines": [
        "¡Hola! Soy Ana. Te acompañaré en tu primer cruce. Toca este diálogo para seguir.",
        "Nuestro objetivo es llegar a la otra acera sin que nos alcance ningún coche. Primero preparamos un plan.",
        "Este es el mapa del cruce. Aquí verás la calle, los coches y a los peatones que debes ayudar.",
        "Yo también estoy en el mapa. Antes de salir, mira los carriles: cada coche sigue su propia dirección.",
        "Arriba está PAUSA (Ⅱ). Puedes descansar, reiniciar el intento o volver al mapa desde ahí.",
        "Estas son tus FICHAS ●. Las habilidades y mejoras cuestan fichas; el contador muestra cuántas te quedan.",
        "Aquí eliges al peatón que vas a preparar. En este primer camino solo estoy yo: Ana.",
        "En HABILIDADES eliges lo que hace cada peatón. Hoy aprenderemos a MIRAR antes de entrar a un carril.",
        "LA CALLE reúne mejoras que protegen el camino. Las conocerás en los siguientes niveles.",
        "Los tres cruces indican por dónde saldré. Elegir el camino no basta: también necesito una habilidad segura.",
        "Ahora elige mi cruce: Izquierda, Centro o Derecha. Toca una de estas opciones; te recomiendo el Centro."
      ],
      "readyMessage": "¡Plan listo! Toca PONER EL PLAN EN MARCHA. Caminaré sola siguiendo tus decisiones; observa cómo espero para cruzar."
    },
